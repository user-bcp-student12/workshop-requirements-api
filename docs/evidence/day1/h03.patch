+++ b/app/task_service.py
@@ -0,0 +1,36 @@
+import sqlite3
+
+from app.schemas import SummaryResponse, TaskInput, TaskResponse
+from app.task_repository import TaskRepository
+
+HIGH_PRIORITY = "HIGH"
+CLOSED_TASK_STATUSES = frozenset({"DONE", "ARCHIVED"})
+
+
+def select_owner(owner: str | None, username: str) -> str:
+    return owner or username
+
+
+def task_from_row(row: sqlite3.Row) -> TaskResponse:
+    return TaskResponse.model_validate(dict(row))
+
+
+class TaskService:
+    def __init__(self, repository: TaskRepository) -> None:
+        self.repository = repository
+
+    def list_tasks(self, owner: str) -> list[TaskResponse]:
+        return [task_from_row(row) for row in self.repository.list_tasks(owner)]
+
+    def create_task(self, task: TaskInput) -> TaskResponse:
+        return task_from_row(self.repository.create_task(task))
+
+    def summary(self, owner: str) -> SummaryResponse:
+        rows = self.repository.summary_rows(owner)
+        response = SummaryResponse(owner=owner, total=len(rows))
+        for row in rows:
+            status = row["status"]
+            response.by_status[status] = response.by_status.get(status, 0) + 1
+            if row["priority"] == HIGH_PRIORITY and status not in CLOSED_TASK_STATUSES:
+                response.high_priority_open += 1
+        return response
